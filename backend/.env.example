# Server
PORT=3000
NODE_ENV=development

# Firebase project (used for reference/logging; the SDK also reads it from the
# service account credentials below)
FIREBASE_PROJECT_ID=cafeshopassignment

# Firebase Admin credentials — provide ONE of the following two.
# Option A: paste the full service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: point to a service account JSON file on disk instead of option A.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Anthropic (Claude) API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# How many of a user's past orders to feed into the chat assistant's context.
CHAT_ORDER_HISTORY_LIMIT=5
