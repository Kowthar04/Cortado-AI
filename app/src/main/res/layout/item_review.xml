<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rating Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/reviewUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textColor="#4A2C2A"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/reviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 Nov 2025"
                android:textColor="#7B5A4D"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Rating Bar -->
        <RatingBar
            android:id="@+id/reviewRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:isIndicator="true"
            android:rating="4"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:progressTint="#FFD700"
            android:layout_marginBottom="6dp" />

        <!-- Review Comment -->
        <TextView
            android:id="@+id/reviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Great coffee and fast service!"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"/>

        <!-- Optional: Highlight sentiment -->
        <TextView
            android:id="@+id/reviewSentiment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Highly Positive"
            android:textColor="#810100"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>
</androidx.cardview.widget.CardView>