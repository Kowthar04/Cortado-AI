rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // self can create their own doc, but never as admin
      allow create: if request.auth.uid == userId && request.resource.data.role != "admin";

      // self can update their own doc, but can't change their own role
      allow update: if request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;

      allow write: if isAdmin();
    }


    match /menuItems/{menuId} {

      allow read: if request.auth != null;


      allow write: if isAdmin();
    }


    match /orders/{orderId} {

      allow read, write: if isAdmin();


      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;


      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }


    match /reviews/{reviewId} {

      allow read, write: if isAdmin();


      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;


      allow read, update, delete: if request.auth != null && resource.data.customerId == request.auth.uid;
    }

    match /notifications/{notificationId} {

      allow read, write, update, delete: if isAdmin();


      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
    }


    match /payments/{paymentId} {

      allow read, write: if isAdmin();

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
